# Copy to .env. Keep real secrets out of chat and source control.
TENANT_ID=REPLACE_TENANT_GUID
CLIENT_ID=REPLACE_ENTRA_APP_GUID
CLIENT_SECRET=REPLACE_LOCALLY
POWERBI_OAUTH_CONNECTION=powerbi
MODEL_CONFIG=./config/model.json
PORT=3978
TAB_ORIGIN=https://REPLACE_YOUR_TUNNEL_OR_HOST

# Approved organisation URLs used when preparing the Teams manifest.
WEBSITE_URL=https://infobics.com
PRIVACY_URL=REPLACE_APPROVED_HTTPS_URL
TERMS_URL=REPLACE_APPROVED_HTTPS_URL

# 64 hex characters; keep stable to decrypt saved reports. Generate securely on the server.
STATE_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX_KEY
