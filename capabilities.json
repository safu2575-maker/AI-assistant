{
  "dataRoles": [
    {
      "name": "fields",
      "displayName": "Fields (dimensions, dates and categories)",
      "kind": "Grouping"
    },
    {
      "name": "measures",
      "displayName": "Measures and KPIs",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "fields"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "measures"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "general": {
      "displayName": "General",
      "properties": {
        "filter": {
          "type": { "filter": true }
        },
        "selfFilter": {
          "type": { "filter": { "selfFilter": false } }
        }
      }
    },
    "state": {
      "displayName": "Conversation state",
      "properties": {
        "conversation": {
          "displayName": "Saved conversation",
          "type": { "text": true }
        }
      }
    }
  },
  "privileges": [],
  "supportsHighlight": true,
  "supportsMultiVisualSelection": true,
  "supportsEmptyDataView": true,
  "supportsSynchronizingFilterState": true
}
