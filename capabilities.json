{
  "dataRoles": [
    {
      "name": "fields",
      "displayName": "Fields (dimensions, dates and categories)",
      "kind": "Grouping"
    },
    {
      "name": "measures",
      "displayName": "Measures and KPIs",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [{ "fields": { "min": 1 }, "measures": { "max": 0 } }],
      "table": {
        "rows": {
          "select": [{ "for": { "in": "fields" } }],
          "dataReductionAlgorithm": { "window": { "count": 30000 } }
        }
      }
    },
    {
      "conditions": [{ "fields": { "min": 1 }, "measures": { "min": 1 } }],
      "matrix": {
        "rows": {
          "for": {
            "in": "fields"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "for": {
            "in": "measures"
          }
        }
      }
    }
  ],
  "objects": {
    "parameterTrial": {
      "displayName": "Field parameter test",
      "properties": {
        "configuration": {
          "type": {
            "text": true
          }
        },
        "filter": {
          "type": {
            "filter": {
              "selfFilter": true
            }
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "filter": {
          "type": {
            "filter": true
          }
        },
        "filter2": {
          "type": {
            "filter": true
          }
        },
        "filter3": {
          "type": {
            "filter": true
          }
        },
        "filter4": {
          "type": {
            "filter": true
          }
        },
        "filter5": {
          "type": {
            "filter": true
          }
        },
        "filter6": {
          "type": {
            "filter": true
          }
        },
        "filter7": {
          "type": {
            "filter": true
          }
        },
        "filter8": {
          "type": {
            "filter": true
          }
        },
        "selfFilter": {
          "type": {
            "filter": {
              "selfFilter": false
            }
          }
        }
      }
    },
    "state": {
      "displayName": "Conversation state",
      "properties": {
        "conversation": {
          "displayName": "Saved conversation",
          "type": {
            "text": true
          }
        }
      }
    },
    "modelTotals": {
      "properties": {
        "rowSubtotalsPerLevel": {
          "type": {
            "bool": true
          }
        },
        "levelSubtotalEnabled": {
          "type": {
            "bool": true
          }
        },
        "columnSubtotals": {
          "type": {
            "bool": true
          }
        },
        "columnSubtotalsPerLevel": {
          "type": {
            "bool": true
          }
        },
        "rowSubtotals": {
          "type": {
            "bool": true
          }
        }
      },
      "displayName": "Model totals"
    }
  },
  "privileges": [{ "name": "ExportContent", "essential": false }],
  "supportsHighlight": true,
  "supportsMultiVisualSelection": true,
  "supportsEmptyDataView": true,
  "supportsSynchronizingFilterState": true,
  "subtotals": {
    "matrix": {
      "rowSubtotalsPerLevel": {
        "defaultValue": false,
        "propertyIdentifier": {
          "propertyName": "rowSubtotalsPerLevel",
          "objectName": "modelTotals"
        }
      },
      "levelSubtotalEnabled": {
        "defaultValue": true,
        "propertyIdentifier": {
          "propertyName": "levelSubtotalEnabled",
          "objectName": "modelTotals"
        }
      },
      "columnSubtotals": {
        "defaultValue": true,
        "propertyIdentifier": {
          "propertyName": "columnSubtotals",
          "objectName": "modelTotals"
        }
      },
      "columnSubtotalsPerLevel": {
        "defaultValue": false,
        "propertyIdentifier": {
          "propertyName": "columnSubtotalsPerLevel",
          "objectName": "modelTotals"
        }
      },
      "rowSubtotals": {
        "defaultValue": true,
        "propertyIdentifier": {
          "propertyName": "rowSubtotals",
          "objectName": "modelTotals"
        }
      }
    }
  }
}
